# CTS VPN Provisioning Proxy — environment configuration
# Copy to .env and fill in values, then: chmod 600 .env
# Use install.sh for interactive setup — it generates this file automatically.

# ── Network identity ──────────────────────────────────────────────────────────
# The HTTPS domain for this provisioning server (must match your DNS A record)
PROV_DOMAIN=https://prov.yourcompany.com

# This VPS's public IP address (auto-detected by install.sh)
VULTR_PUBLIC_IP=1.2.3.4

# ── TLS certificate ───────────────────────────────────────────────────────────
# "letsencrypt" — automatic free cert via certbot (requires valid DNS + port 80)
# "selfsigned"  — self-signed cert, instant, no DNS required (testing only)
# Note: Yealink phones reject self-signed certs unless you push the CA cert.
TLS_MODE=letsencrypt

# Email for Let's Encrypt expiry notices (only used when TLS_MODE=letsencrypt)
CERTBOT_EMAIL=admin@yourcompany.com

# ── SkySwitch ─────────────────────────────────────────────────────────────────
# Base URL of your SkySwitch provisioning server.
# Find in: SkySwitch Portal → Settings → Provisioning
# Common values: https://cfg.skyswitch.net  or  https://p3.zswitch.net
# Reserved for future upstream-fetch integration; not currently used by the app.
SKYSWITCH_PROV_URL=https://cfg.skyswitch.net

# ── Authentication ────────────────────────────────────────────────────────────
# Admin API bearer token — generate with: openssl rand -hex 32
ADMIN_TOKEN=replace-with-strong-random-secret

# Optional shared secret Yealink phones send when fetching configs.
# Leave blank to disable token checking. Generate with: openssl rand -hex 16
PROV_TOKEN=

# Dashboard (/dashboard) login credentials
# If DASHBOARD_PASSWORD is empty the dashboard is inaccessible.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# ── OpenVPN ───────────────────────────────────────────────────────────────────
# UDP port for OpenVPN (default 1194 — only change if blocked upstream)
VPN_PORT=1194

# ── WireGuard (optional) ──────────────────────────────────────────────────────
# Set to "yes" to install WireGuard alongside OpenVPN (for admin/staff access)
WG_ENABLED=no

# WireGuard virtual subnet — must NOT overlap with OpenVPN's 10.8.0.0/24
WG_SUBNET=10.9.0.0/24

# WireGuard listen port
WG_PORT=51820

# DNS servers pushed to WireGuard clients
WG_DNS=8.8.8.8,1.1.1.1

# Number of initial client .conf files to generate at install time
WG_CLIENT_COUNT=5

# ── Paths (defaults work on standard Ubuntu install) ──────────────────────────
PKI_DIR=/etc/openvpn/easy-rsa/pki
EASYRSA_BIN=/etc/openvpn/easy-rsa/easyrsa
CACHE_DIR=/opt/cts-prov/cache
DB_PATH=/opt/cts-prov/devices.db
